# API Keys (rename to .env and add your keys)
OPENAI_API_KEY=sk-your-openai-key-here
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here

# Model Configuration
DEFAULT_MODEL=gpt-4-turbo
MAX_TOKENS=4096
TEMPERATURE=0.7

# Experiment Settings
EXPERIMENT_SEED=42
CACHE_DIR=./data/cache
RESULTS_DIR=./results

# Logging
LOG_LEVEL=INFO
LOG_FILE=./results/logs/experiment.log

# Rate Limiting
MAX_REQUESTS_PER_MINUTE=50
RETRY_ON_ERROR=true
